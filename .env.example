# --- Database ---------------------------------------------------------------
# Postgres in docker/Railway. Leave unset locally to use SQLite at data/m3tdf.sqlite.
DATABASE_URL=postgresql+psycopg://m3:m3@localhost:5432/m3tdf
# Used by docker-compose.yml for the db container (local development credentials only).
POSTGRES_USER=m3
POSTGRES_PASSWORD=m3
POSTGRES_DB=m3tdf

# --- Auth (server-side roles) ------------------------------------------------
# Comma-separated role:key pairs. Roles: viewer, analyst, owner.
API_KEYS=viewer:change-me-viewer,analyst:change-me-analyst,owner:change-me-owner

# --- LLM (single provider behind llm/client.py) ------------------------------
# LLM_PROVIDER=anthropic (Anthropic SDK, e.g. LLM_MODEL=claude-sonnet-5, $2/$10 per MTok)
# LLM_PROVIDER=groq (OpenAI-compatible API, e.g. LLM_MODEL=openai/gpt-oss-120b, $0.15/$0.60 per MTok)
# LLM_PROVIDER=none disables the LLM (heuristic mapper only).
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# USD per million tokens, used to compute ops.llm_calls.cost_usd. Check current pricing before relying on it.
LLM_PRICE_IN_PER_MTOK=2.00
LLM_PRICE_OUT_PER_MTOK=10.00

# --- Pipeline -----------------------------------------------------------------
DATA_DIR=data
# A batch whose extract landed more than this many hours after its period end is flagged stale.
SOURCE_SLA_HOURS=72
API_BASE_URL=http://localhost:8000
